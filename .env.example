# Copy to .env (never commit .env) or export in your shell.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Vertex AI alternative:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# Optional tuning
# GEMINI_TIMEOUT_S=90
# GEMINI_THINKING_LEVEL=low
# Secret for DELETE /api/assessments (X-Admin-Token header); leave unset to disable the reset endpoint
# KERVAN_ADMIN_TOKEN=change-me
